# ============================================================
# 团队档案管理系统（TravelManager）环境变量示例
# 使用方法：复制本文件为 .env，按部署环境填写后再启动服务
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止把真实密钥提交到代码仓库
# ============================================================

# ---------- 基础服务 ----------
# 服务监听端口
PORT=8080
# Gin 运行模式：debug / release（生产环境请使用 release）
GIN_MODE=release
# 对外展示的版本号（GET /api/system/info 返回）
APP_VERSION=0.1.0

# ---------- 安全密钥（必须修改为高强度随机值） ----------
# JWT 签名密钥：至少 32 位随机字符串，缺失或过短时服务拒绝启动
# 生成示例：openssl rand -base64 48
JWT_SECRET=
# 首次创建超级管理员的一次性令牌：仅在空数据库初始化时使用，初始化完成后请删除
# 生成示例：openssl rand -hex 32
INITIAL_ADMIN_TOKEN=
# 登录令牌有效期（小时）
TOKEN_TTL_HOURS=72

# ---------- 数据库 ----------
# 数据库类型：sqlite / mysql
DB_TYPE=sqlite

# SQLite 配置（DB_TYPE=sqlite 时生效）
DB_PATH=travelmanager.db

# MySQL 配置（DB_TYPE=mysql 时生效，账号密码请使用独立高强度密码）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=TravelManager
DB_USER=TravelManager
DB_PASSWORD=
DB_CHARSET=utf8mb4

# 生产环境可关闭自动建表（关闭后仅执行必要的定向迁移）
SKIP_AUTO_MIGRATE=false

# ---------- 上传与本地存储 ----------
UPLOAD_DIR=storage/uploads
# 单个上传文件大小上限（MB）
UPLOAD_MAX_SIZE_MB=5
# 允许上传的扩展名（逗号分隔，不含点）
UPLOAD_ALLOWED_EXTS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ---------- 系统与业务默认值 ----------
# 以下为系统首次运行时的默认值，部署后可在「系统设置」中修改并写入数据库；
# 数据库中的设置优先级高于环境变量。
SYSTEM_NAME=团队档案管理系统
TEAM_TYPES=研学,团建,旅游团
EXPENSE_CATEGORIES=门票,住宿,餐饮,景区内部消费
OAUTH_MODE=rainbow
OAUTH_PROVIDERS=qq,wechat,weibo

# ---------- 跨域 ----------
# 允许跨域访问的来源，逗号分隔；默认 * 表示不限制（生产环境建议收敛为实际域名）
CORS_ALLOW_ORIGINS=*

# ---------- 云存储 / 邮件 / 短信 / 高德地图 ----------
# 这些第三方凭据不写入代码或 .env，统一在系统「设置」页配置并保存到数据库，
# 数据库中已保存的敏感项在接口返回时会自动脱敏为 ********。
# 如需预置，请通过管理后台录入，切勿提交到版本库。

# ---------- 反向代理（可选） ----------
# 部署在 Nginx / Caddy 之后时，请确保透传 Host 与 X-Forwarded-Proto，
# 第三方登录回调地址会依据请求域名自动生成。
